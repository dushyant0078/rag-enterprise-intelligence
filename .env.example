# Copy to .env and fill in real values locally. Never commit .env.
# Wired up progressively as each component lands (LLM in Milestone 6-7,
# vector store in Milestone 5, API auth in Milestone 9, tracing/LangSmith
# in Milestone 11). No dotenv auto-loading anywhere in this project --
# export these as real environment variables (or let your deployment
# platform inject them), the same way ANTHROPIC_API_KEY etc. always have.

# --- LLM providers (only the configured backend needs a key — see configs/llm/) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=          # used by the Cohere reranker option

# --- Vector store (only the configured backend needs credentials — see configs/vectorstore/) ---
QDRANT_URL=
QDRANT_API_KEY=
WEAVIATE_URL=
WEAVIATE_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- Observability (Milestone 11 wires these up for real) ---
MLFLOW_TRACKING_URI=http://localhost:5000
LANGSMITH_API_KEY=          # src/monitoring/langsmith_integration.py; unset = LangSmith tracing
# is a real no-op (langsmith's own SDK behavior), not an error
LANGSMITH_PROJECT=rag-enterprise-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # read directly in api/main.py's lifespan;
# unset = no OTLP export, but pipeline-stage + HTTP spans are still generated (see
# RAG_TRACE_CONSOLE below to see them locally without a collector)

# --- API / Auth (Milestone 9) ---
# Demo API keys (src/security/api_auth.py) -- if unset, random ones are generated at
# startup and printed nowhere (check the running process's ApiKeyRegistry for local dev).
# Set these for a stable key across restarts.
API_ADMIN_KEY=                # unrestricted -- can see every domain, upload, reindex
API_HR_KEY=                   # scoped to the "hr" domain only -- see the RBAC tests in tests/api/

# --- App ---
APP_ENV=local              # local | staging | production
LOG_LEVEL=INFO

# --- API data paths (Milestone 9) -- override to point the API at a different corpus/index,
# or to isolate test runs from real project data (see tests/api/conftest.py) ---
RAG_PROCESSED_DIR=data/processed
RAG_INDEX_DIR=data/embeddings/faiss_index
RAG_RAW_UPLOAD_DIR=data/raw/api_uploads
RAG_METADATA_DIR=data/metadata
RAG_FEEDBACK_DIR=data/feedback

# --- Monitoring & observability (Milestone 11) ---
RAG_TRACE_CONSOLE=false     # true prints every OpenTelemetry span to stdout -- useful for
# local debugging, noisy in production/CI; the real span data itself always flows regardless
# (see src/monitoring/tracing.py) -- this only controls the console exporter
